{
  "name": "chips-and-cookies",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "nub run build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@vanilla-extract/css": "^1.21.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "intent": {
    "skills": [
      "*"
    ]
  },
  "packageManager": "nub@0.9.3",
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.3",
      "onFail": "ignore"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "lightningcss": true,
    "sharp": true,
    "workerd": true
  }
